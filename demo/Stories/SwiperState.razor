<section class="demo-model" aria-label="Live Swiper state">
    <h3>Live state</h3>
    <pre data-testid="@TestId">@Log.ToJson()</pre>
</section>

@code {
    [Parameter, EditorRequired]
    public SwiperEventLog Log { get; set; } = new();

    [Parameter, EditorRequired]
    public string TestId { get; set; } = string.Empty;
}
